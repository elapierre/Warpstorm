{
  "expo": {
    "name": "HubMobile",
    "slug": "HubMobile",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/holman_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
