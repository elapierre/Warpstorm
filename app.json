      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ericlapierre.HubMobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d32bd8fe-7a0e-4310-89ed-c7d12b79ebfa"
      }
    }
  }
}
